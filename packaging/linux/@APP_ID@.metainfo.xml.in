<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from @APP_ID@.metainfo.xml.in by tools/branding.py sync. -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later AND GPL-3.0-only</project_license>
  <name>@APP_NAME@</name>
  <name xml:lang="tr">@APP_NAME_TR@</name>
  <summary>Unofficial notes client compatible with Samsung Notes</summary>
  <summary xml:lang="tr">Samsung Notes ile uyumlu, resmi olmayan not istemcisi</summary>
  <developer id="io.github.tunahanyrd">
    <name>@DEVELOPER_NAME@</name>
  </developer>
  <description>
    <p>
      @APP_NAME@ is a desktop notes application that reads and writes notes in
      the Samsung Notes format and keeps them in sync with your Samsung Cloud
      account: handwritten pages, text notes, folders, favorites and the trash.
    </p>
    <ul>
      <li>Handwritten pages rendered from the original strokes, with pen, eraser and lasso tools</li>
      <li>Rich text editing, PDF backgrounds and page management</li>
      <li>Works offline; changes are queued and verified after upload</li>
    </ul>
    <p>
      @DISCLAIMER@
    </p>
  </description>
  <launchable type="desktop-id">@APP_NAME@.desktop</launchable>
  <url type="homepage">@REPOSITORY@</url>
  <url type="bugtracker">@REPOSITORY@/issues</url>
  <url type="vcs-browser">@REPOSITORY@</url>
  <categories>
    <category>Office</category>
  </categories>
  <keywords>
    <keyword>notes</keyword>
    <keyword>handwriting</keyword>
    <keyword>pen</keyword>
    <keyword>Samsung Notes</keyword>
  </keywords>
  <provides>
    <binary>@BINARY_NAME@</binary>
  </provides>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <supports>
    <control>tablet</control>
    <control>touch</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#f2d5d2</color>
    <color type="primary" scheme_preference="dark">#7a2c25</color>
  </branding>
  <releases>
    <release version="0.0.1-alpha" date="2026-10-28" type="development">
      <url type="details">@REPOSITORY@/releases/tag/v0.0.1-alpha</url>
      <description>
        <p>First public pre-release (alpha).</p>
        <ul>
          <li>Samsung account sign-in and Samsung Cloud sync with offline reading</li>
          <li>Plain and rich text editing, also in notes with handwriting or inserted pictures</li>
          <li>Pen with colour and thickness, highlighter, eraser, lasso move, shapes</li>
          <li>Page background colours, page management, PDF insertion and templates</li>
          <li>Previews for every page type; every Cloud write is verified by reading the note back</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
